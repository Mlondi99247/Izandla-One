
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Izandla One | Driver Portal</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--blue:#168bd2;--dark:#07558e;--light:#eaf7ff}
*{box-sizing:border-box}
body{margin:0;background:#eef8ff;color:#17354a;font-family:Arial,sans-serif}
header{background:linear-gradient(120deg,#0879bd,#31b4ed);color:white;padding:25px 18px;text-align:center}
header h1{margin:0;font-size:27px}
header p{margin:8px 0 0}
main{max-width:520px;margin:22px auto;padding:0 14px}
.card{background:white;border-radius:17px;padding:22px;margin-bottom:17px;box-shadow:0 5px 22px #174e7115}
h2{color:#0879bd;margin-top:0}
input{width:100%;padding:14px;margin:7px 0 13px;border:1px solid #c9dce9;border-radius:9px;font-size:16px}
button{width:100%;border:0;border-radius:10px;padding:15px;background:#087fca;color:white;font-size:16px;font-weight:bold;margin-top:8px;cursor:pointer}
button.secondary{background:#e4f4ff;color:#07558e}
button:disabled{opacity:.55}
.small{text-align:center;font-size:13px;color:#668096}
.message{padding:13px;border-radius:9px;margin:12px 0;display:none;line-height:1.5}
.success{background:#e5f8ec;color:#176b37}
.error{background:#fff0ed;color:#a52e20}
.pending{background:#fff7df;color:#775500}
.job{border:1px solid #d6e9f5;border-radius:12px;padding:14px;margin:12px 0}
.job h3{margin:0 0 8px;color:#0879bd}
.hidden{display:none}
a{color:#0879bd}
footer{text-align:center;padding:25px;color:#71899b;font-size:13px}
</style>
</head>
<body>

<header>
<h1>🤝 IZANDLA ONE</h1>
<p>Driver Partner Portal</p>
<p><b>Quality uplifts the world</b></p>
</header>

<main>

<section id="authSection">
<div class="card">
<h2>Driver Registration</h2>
<p>Register to become an Izandla One driver partner.</p>

<div id="registerMessage" class="message"></div>

<form id="registerForm">
<label>Full name</label>
<input id="fullName" required autocomplete="name" placeholder="Your full name">

<label>Email / Account</label>
<input id="email" type="email" required autocomplete="email" placeholder="Your email address">

<label>Phone number</label>
<input id="phone" type="tel" required autocomplete="tel" placeholder="Your mobile number">

<label>Create password</label>
<input id="password" type="password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters">

<label>Confirm password</label>
<input id="confirmPassword" type="password" required minlength="8" autocomplete="new-password" placeholder="Repeat password">

<button id="registerButton" type="submit">REGISTER AS DRIVER</button>
</form>
</div>

<div class="card">
<h2>Already registered?</h2>
<div id="loginMessage" class="message"></div>
<form id="loginForm">
<label>Email address</label>
<input id="loginEmail" type="email" required autocomplete="email" placeholder="Your email">

<label>Password</label>
<input id="loginPassword" type="password" required autocomplete="current-password" placeholder="Your password">

<button type="submit">DRIVER LOGIN</button>
</form>
</div>
</section>

<section id="pendingSection" class="hidden">
<div class="card">
<h2>Registration received!</h2>
<div class="message pending" style="display:block">
<b>Your application is awaiting administration approval.</b><br><br>
Please contact Izandla One administration for verification and activation.
</div>
<p>Your profile has been registered. You cannot receive jobs until administration approves and activates your driver account.</p>
<p><b>Contact administration:</b></p>
<p>Phone: 079 510 0296<br>Email: Izandla.one@gmail.com</p>
<button onclick="logout()">LOG OUT</button>
</div>
</section>

<section id="dashboardSection" class="hidden">
<div class="card">
<h2>Driver Dashboard</h2>
<p id="driverWelcome"></p>
<div class="message success" style="display:block">
Your driver account is approved and activated.
</div>
<p><b>Available rides and delivery requests</b></p>
<div id="jobsList">Loading available requests...</div>
<button class="secondary" onclick="loadJobs()">REFRESH REQUESTS</button>
<button onclick="logout()">LOG OUT</button>
</div>
</section>

</main>

<footer>
IZANDLA ONE · Quality uplifts the world<br>
Secure driver registration portal
</footer>

<script>
const SUPABASE_URL = "https://ejsdxxapryebecgmkekf.supabase.co";
const SUPABASE_KEY = "sb_publishable_hvKxq3KkZNrmKMSNXlyYWg_hmFm5AYd";

const db = window.supabase.createClient(
  SUPABASE_URL,
  SUPABASE_KEY
);

const $ = id => document.getElementById(id);

function showMessage(id, message, type="error"){
  const box = $(id);
  box.textContent = message;
  box.className = "message " + type;
  box.style.display = "block";
}

function hideSections(){
  $("authSection").classList.add("hidden");
  $("pendingSection").classList.add("hidden");
  $("dashboardSection").classList.add("hidden");
}

async function createDriverRecords(user, name, phone){
  // Check whether a profile already exists.
  const {data: profile, error: profileError} = await db
    .from("izandla_profiles")
    .select("user_id,role")
    .eq("user_id", user.id)
    .maybeSingle();

  if(profileError) throw profileError;

  if(profile && profile.role !== "driver"){
    throw new Error("This account is not registered with the driver role. Contact administration.");
  }

  if(!profile){
    const {error} = await db
      .from("izandla_profiles")
      .insert({
        user_id:user.id,
        role:"driver",
        email:user.email,
        store_id:null
      });

    if(error) throw error;
  }

  // Check whether the driver record already exists.
  const {data: driver, error: driverError} = await db
    .from("izandla_drivers")
    .select("user_id")
    .eq("user_id",user.id)
    .maybeSingle();

  if(driverError) throw driverError;

  if(!driver){
    const {error} = await db
      .from("izandla_drivers")
      .insert({
        user_id:user.id,
        full_name:name,
        phone:phone,
        available:false,
        verified:false,
        activated:false
      });

    if(error) throw error;
  }
}

async function showDriverStatus(user){
  const {data: driver,error} = await db
    .from("izandla_drivers")
    .select("full_name,verified,activated,available")
    .eq("user_id",user.id)
    .maybeSingle();

  if(error) throw error;

  if(!driver){
    throw new Error("Driver record not found. Please contact administration.");
  }

  hideSections();

  if(driver.verified === true && driver.activated === true){
    $("dashboardSection").classList.remove("hidden");
    $("driverWelcome").textContent =
      "Welcome, " + driver.full_name + ".";
    loadJobs();
  }else{
    $("pendingSection").classList.remove("hidden");
  }
}

// DRIVER REGISTRATION
$("registerForm").addEventListener("submit",async e=>{
  e.preventDefault();

  const name=$("fullName").value.trim();
  const email=$("email").value.trim().toLowerCase();
  const phone=$("phone").value.trim();
  const password=$("password").value;
  const confirm=$("confirmPassword").value;

  if(password!==confirm){
    showMessage("registerMessage","Passwords do not match.");
    return;
  }

  $("registerButton").disabled=true;
  $("registerButton").textContent="REGISTERING...";

  try{
    const {data,error}=await db.auth.signUp({
      email,
      password,
      options:{
        data:{
          full_name:name,
          phone:phone,
          role:"driver"
        }
      }
    });

    if(error) throw error;

    if(!data.session){
      showMessage(
        "registerMessage",
        "Your account has been created. Please check your email, confirm your address, then return here and log in to complete your driver profile.",
        "success"
      );
      return;
    }

    await createDriverRecords(data.user,name,phone);

    showMessage(
      "registerMessage",
      "Registration successful! Please contact administration for verification and activation.",
      "success"
    );

    await showDriverStatus(data.user);

  }catch(error){
    showMessage("registerMessage",error.message);
  }finally{
    $("registerButton").disabled=false;
    $("registerButton").textContent="REGISTER AS DRIVER";
  }
});

// DRIVER LOGIN
$("loginForm").addEventListener("submit",async e=>{
  e.preventDefault();

  try{
    showMessage("loginMessage","Signing in...","success");

    const {data,error}=await db.auth.signInWithPassword({
      email:$("loginEmail").value.trim().toLowerCase(),
      password:$("loginPassword").value
    });

    if(error) throw error;

    const user=data.user;
    const name=user.user_metadata?.full_name || "";
    const phone=user.user_metadata?.phone || "";

    await createDriverRecords(user,name,phone);
    await showDriverStatus(user);

  }catch(error){
    showMessage("loginMessage",error.message);
  }
});

// AVAILABLE REQUESTS
async function loadJobs(){
  const box=$("jobsList");
  box.textContent="Loading available requests...";

  try{
    const {data:jobs,error}=await db
      .from("izandla_requests")
      .select("id,created_at,service,customer_name,phone,details,status")
      .eq("available_to_drivers",true)
      .eq("verified",true)
      .limit(30);

    if(error) throw error;

    if(!jobs || jobs.length===0){
      box.textContent="No available rides or delivery requests at the moment. Please check again.";
      return;
    }

    box.innerHTML="";

    jobs.forEach(job=>{
      const item=document.createElement("div");
      item.className="job";

      const heading=document.createElement("h3");
      heading.textContent=job.service || "Customer request";

      const details=document.createElement("p");
      details.textContent=
        "Customer: "+(job.customer_name || "Customer")+
        " | Contact: "+(job.phone || "Not provided")+
        " | Status: "+(job.status || "Available");

      const claim=document.createElement("button");
      claim.textContent="ACCEPT REQUEST";

      claim.onclick=async()=>{
        claim.disabled=true;
        claim.textContent="PROCESSING...";

        try{
          const {error}=await db.rpc(
            "izandla_claim_order",
            {p_order_id:job.id}
          );

          if(error) throw error;

          alert("Request accepted successfully!");
          loadJobs();

        }catch(err){
          alert("Could not accept request: "+err.message);
          claim.disabled=false;
          claim.textContent="ACCEPT REQUEST";
        }
      };

      item.appendChild(heading);
      item.appendChild(details);

      if(job.details){
        const extra=document.createElement("p");
        extra.textContent=typeof job.details==="string"
          ? job.details
          : JSON.stringify(job.details);
        item.appendChild(extra);
      }

      item.appendChild(claim);
      box.appendChild(item);
    });

  }catch(error){
    box.textContent="Could not load requests: "+error.message+
      ". Please contact administration if this continues.";
  }
}

// LOGOUT
async function logout(){
  await db.auth.signOut();
  hideSections();
  $("authSection").classList.remove("hidden");
}

// RESTORE EXISTING SESSION
(async()=>{
  const {data:{session}}=await db.auth.getSession();

  if(session){
    try{
      await showDriverStatus(session.user);
    }catch(error){
      hideSections();
      $("authSection").classList.remove("hidden");
      showMessage("loginMessage",error.message);
    }
  }
})();
</script>
</body>
</html>

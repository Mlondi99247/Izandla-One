<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🤝 Izandla Zezulu | Premium Sneaker & Shoe Spa | From R120</title>

<!-- BADGE - Shows when saved from Chrome -->
<link rel="icon" href="/favicon.ico">
<link rel="apple-touch-icon" href="/icon-192.png">
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#000000">

<style>
*{margin:0;padding:0;box-sizing:border-box;font-family:Arial, sans-serif;}
body{background:#fff;color:#111;}
header{background:#000;color:#fff;padding:15px 20px;display:flex;justify-content:space-between;align-items:center;}
header h1{font-size:20px;font-weight:900;}
header a{background:#fff;color:#000;padding:8px 16px;border-radius:20px;font-weight:bold;font-size:14px;text-decoration:none;}
.hero{background:#000;color:#fff;text-align:center;padding:70px 20px;}
.hero h2{font-size:44px;font-weight:900;line-height:1.1;}
.hero h2 span{color:gold;}
.btn{display:inline-block;margin-top:25px;padding:14px 32px;background:#fff;color:#000;border-radius:30px;font-weight:900;text-decoration:none;}
footer{background:#000;color:#fff;text-align:center;padding:30px;margin-top:60px;}
footer a{color:gold;text-decoration:none;}
</style>
</head>
<body>

<header>
<h1>🤝 IZANDLA ZEZULU</h1>
<a href="https://wa.me/27795100296">079 510 0296</a>
</header>

<section class="hero">
<h2>🤝 Premium<br><span>Sneaker & Shoe Spa</span></h2>
<p>Empangeni • From R120/pair • Quality, Not Street Wash</p>
<p style="margin-top:10px;color:gold;">🤝 Trusted • Quality Guaranteed</p>
<a class="btn" href="#sneaker-shoe-section">🤝 Book Your Pair Now</a>
</section>

<section id="sneaker-shoe-section" style="max-width:1000px;margin:0 auto;padding:40px 20px;">
  <h2 style="text-align:center;font-size:34px;font-weight:900;">🤝 Choose Service</h2>

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-top:30px;">
    <div style="border:2px solid #000;border-radius:20px;padding:22px;position:relative;">
      <button onclick="closeBooking()" style="position:absolute;top:10px;right:12px;background:#eee;border:none;width:28px;height:28px;border-radius:50%;font-weight:bold;cursor:pointer;">X</button>
      <div style="font-size:42px;">👟</div>
      <h3>Standard Sneaker Wash</h3>
      <p style="color:#555;font-size:14px;">Deep clean, deodorize, whitening</p>
      <div style="margin:14px 0;"><span style="font-size:28px;font-weight:900;">R120</span> / pair</div>
      <button onclick="selectService('sneaker',120)" style="width:100%;padding:13px;background:#000;color:#fff;border:none;border-radius:30px;font-weight:bold;cursor:pointer;">🤝 Book R120</button>
    </div>

    <div style="border:2px solid #000;border-radius:20px;padding:22px;background:#FFFBEB;position:relative;">
      <button onclick="closeBooking()" style="position:absolute;top:10px;right:12px;background:#000;color:#fff;border:none;width:28px;height:28px;border-radius:50%;font-weight:bold;cursor:pointer;">X</button>
      <div style="font-size:42px;">✨👟</div>
      <h3>Premium Sneaker Spa</h3>
      <p style="color:#555;font-size:14px;">Jordan, Yeezy, Leather, Suede</p>
      <div style="margin:14px 0;"><span style="font-size:28px;font-weight:900;">R150</span> / pair <span style="background:gold;padding:2px 6px;border-radius:8px;font-size:10px;">BEST</span></div>
      <button onclick="selectService('premium',150)" style="width:100%;padding:13px;background:#000;color:#fff;border:none;border-radius:30px;font-weight:bold;cursor:pointer;">🤝 Book R150</button>
    </div>

    <div style="border:2px solid #ddd;border-radius:20px;padding:22px;grid-column:span 2;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:15px;">
      <div>
        <div style="font-size:32px;">👞</div>
        <h3>Formal Shoe Wash - R90/pair</h3>
        <p style="color:#555;font-size:14px;">Polish, buff & shine</p>
      </div>
      <div style="display:flex;gap:10px;align-items:center;">
        <button onclick="selectService('formal',90)" style="padding:13px 28px;background:#fff;color:#000;border:2px solid #000;border-radius:30px;font-weight:bold;cursor:pointer;">🤝 Book R90</button>
        <button onclick="closeBooking()" style="padding:13px;background:#eee;border:none;border-radius:50%;width:44px;height:44px;font-weight:bold;cursor:pointer;">X</button>
      </div>
    </div>
  </div>

  <div id="bookingForm" style="background:#f5f5f5;padding:25px;border-radius:20px;margin-top:40px;display:none;position:relative;border:2px solid #000;">
    <button onclick="closeBooking()" style="position:absolute;top:15px;right:15px;background:#000;color:#fff;border:none;width:36px;height:36px;border-radius:50%;font-weight:bold;cursor:pointer;font-size:18px;">X</button>
    <h3 style="font-size:22px;font-weight:900;">🤝 Complete Booking</h3>
    <p style="color:#666;font-size:13px;">079 510 0296 • Trusted Partner</p>
    <label style="display:block;margin-top:15px;font-weight:bold;">Service</label>
    <select id="bService" style="width:100%;padding:12px;border-radius:10px;border:1px solid #ccc;margin-top:5px;">
      <option value="sneaker-120">Standard Sneaker Wash - R120</option>
      <option value="premium-150">Premium Sneaker Spa - R150</option>
      <option value="formal-90">Formal Shoe Wash - R90</option>
    </select>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:15px;">
      <div><label style="font-weight:bold;">Pairs</label><input id="bPairs" type="number" min="1" value="1" oninput="calcTotal()" style="width:100%;padding:12px;border-radius:10px;border:1px solid #ccc;margin-top:5px;"></div>
      <div><label style="font-weight:bold;">Pickup Date</label><input id="bDate" type="date" style="width:100%;padding:12px;border-radius:10px;border:1px solid #ccc;margin-top:5px;"></div>
    </div>
    <label style="display:block;margin-top:15px;font-weight:bold;">Add-Ons</label>
    <label style="display:block;margin-top:8px;"><input type="checkbox" id="addWhite" onchange="calcTotal()"> Whitening +R35</label>
    <label style="display:block;margin-top:5px;"><input type="checkbox" id="addDeo" onchange="calcTotal()"> Deodorize +R25</label>
    <label style="display:block;margin-top:5px;"><input type="checkbox" id="addPickup" onchange="calcTotal()"> Pickup & Delivery +R45</label>
    <label style="display:block;margin-top:5px;"><input type="checkbox" id="addExpress" onchange="calcTotal()"> Express 24hr +R50</label>
    <label style="display:block;margin-top:15px;font-weight:bold;">Your Details</label>
    <input id="bName" placeholder="Full Name" style="width:100%;padding:12px;border-radius:10px;border:1px solid #ccc;margin-top:5px;">
    <input id="bPhone" placeholder="079 510 0296" style="width:100%;padding:12px;border-radius:10px;border:1px solid #ccc;margin-top:8px;">
    <div style="background:#fff;padding:15px;border-radius:12px;margin-top:20px;">
      <div style="display:flex;justify-content:space-between;"><span>Subtotal</span><span id="subTotal">R120</span></div>
      <div style="display:flex;justify-content:space-between;font-weight:900;font-size:20px;border-top:1px solid #eee;margin-top:10px;padding-top:10px;"><span>Total</span><span id="grandTotal">R120</span></div>
    </div>
    <button onclick="payNow()" id="payBtn" style="width:100%;padding:16px;background:#000;color:#fff;border:none;border-radius:30px;font-weight:900;font-size:18px;margin-top:20px;cursor:pointer;">🤝 Pay R120 & Book - 079 510 0296</button>
    <button onclick="closeBooking()" style="width:100%;padding:12px;background:#eee;color:#000;border:none;border-radius:30px;font-weight:bold;margin-top:10px;cursor:pointer;">X Close</button>
  </div>
</section>

<footer>
<p style="font-weight:900;">🤝 IZANDLA ZEZULU - Premium Sneaker & Shoe Spa</p>
<p style="margin-top:10px;"><a href="https://wa.me/27795100296">🤝 WhatsApp: 079 510 0296</a></p>
</footer>

<script>
let currentPrice=120;
function selectService(type,price){
  currentPrice=price;
  document.getElementById('bookingForm').style.display='block';
  document.getElementById('bookingForm').scrollIntoView({behavior:'smooth'});
  if(type==='sneaker') document.getElementById('bService').value='sneaker-120';
  if(type==='premium') document.getElementById('bService').value='premium-150';
  if(type==='formal') document.getElementById('bService').value='formal-90';
  calcTotal();
}
function closeBooking(){document.getElementById('bookingForm').style.display='none';}
function calcTotal(){
  const pairs=parseInt(document.getElementById('bPairs').value)||1;
  const base=parseInt(document.getElementById('bService').value.split('-')[1])||currentPrice;
  let total=base*pairs;
  if(document.getElementById('addWhite').checked) total+=35;
  if(document.getElementById('addDeo').checked) total+=25;
  if(document.getElementById('addPickup').checked) total+=45;
  if(document.getElementById('addExpress').checked) total+=50;
  document.getElementById('subTotal').innerText='R'+(base*pairs);
  document.getElementById('grandTotal').innerText='R'+total;
  document.getElementById('payBtn').innerText='🤝 Pay R'+total+' & Book - 079 510 0296';
  return total;
}
function payNow(){
  const total=calcTotal();
  const name=document.getElementById('bName').value;
  const phone=document.getElementById('bPhone').value||'0795100296';
  const date=document.getElementById('bDate').value;
  const service=document.getElementById('bService').value;
  if(!name){alert('Enter name');return;}
  const msg=`🤝 NEW BOOKING%0AName: ${name}%0APhone: ${phone}%0AService: ${service}%0ATotal: R${total}%0ADate: ${date}`;
  window.location.href=`https://wa.me/27795100296?text=${msg}`;
}
const today=new Date().toISOString().split('T')[0];
document.getElementById('bDate').min=today;
document.getElementById('bDate').value=today;
</script>
</body>
  </html>
